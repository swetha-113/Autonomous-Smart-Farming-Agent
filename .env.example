# Anthropic Claude API Key (for LLM-based recommendations)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenWeatherMap API Key (for live weather data)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: Kaggle credentials for dataset download
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Farm Location (default)
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946
DEFAULT_LOCATION=Bangalore, India

# Model paths
CNN_MODEL_PATH=data/models/crop_disease_cnn.h5
SOIL_MODEL_PATH=data/models/soil_health_model.pkl
WEATHER_MODEL_PATH=data/models/weather_forecast_model.pkl

# Logging level
LOG_LEVEL=INFO
